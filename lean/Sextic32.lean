import CubicCertificate

/-! Kernel certificate for five coefficient bits in F₂[t]/(t⁵ + t² + 1).
The packed base-32 digits are logarithms and powers of t; the theorem
`multiplication_model` checks multiplication against direct polynomial reduction. -/
namespace Sextic32
abbrev E := Fin 32
def add (x y : E) : E := ⟨(x.val ^^^ y.val) % 32, Nat.mod_lt _ (by decide)⟩
private def digit (n i : Nat) : E := ⟨(n >>> (5*i)) % 32, Nat.mod_lt _ (by decide)⟩
private def logT (x : E) : Nat :=
  (digit 719976087585702537242947323940304841317326324736 x.val).val
private def expT (i : Nat) : E := digit 26123046934389750782758618732681130701236736065 i

def mul (x y : E) : E := if x = 0 ∨ y = 0 then 0 else
  expT ((logT x + logT y) % 31)

def timesT (x : E) : E := ⟨(((2*x.val) % 32) ^^^ (if x.val.testBit 4 then 5 else 0)) % 32,
  Nat.mod_lt _ (by decide)⟩
private def timesTPow (x : E) : Nat → E
  | 0 => x
  | i+1 => timesT (timesTPow x i)

def polynomialMul (x y : E) : E :=
  (List.range 5).foldl (fun s i => if y.val.testBit i then add s (timesTPow x i) else s) 0

set_option maxRecDepth 100000
set_option maxHeartbeats 0

theorem multiplication_model : ∀ x y : E, mul x y = polynomialMul x y := by decide
def elems : List E := (Array.ofFn id).toList
def inv (a : E) : E := (elems.find? fun b => mul a b == 1).getD 0

theorem arithmetic :
    (∀ x : E, add x x = 0 ∧ add x 0 = x ∧ mul x 1 = x) ∧
    (∀ x y : E, add x y = add y x ∧ mul x y = mul y x) ∧
    (∀ x y z : E, add (add x y) z = add x (add y z) ∧
       mul (mul x y) z = mul x (mul y z) ∧
       mul x (add y z) = add (mul x y) (mul x z)) ∧
    (∀ x : E, x ≠ 0 → mul x (inv x) = 1) := by decide

def sixth (x : E) : E := let cube := mul (mul x x) x; mul cube cube
def value (m b x : E) : E := add (add (sixth x) (mul m x)) b
def mask (xs : List E) : Nat := xs.foldr (fun x n => (1 <<< x.val) ||| n) 0
def lineRows : List Nat := elems.bind fun m => elems.map fun b => mask (elems.map (value m b))

