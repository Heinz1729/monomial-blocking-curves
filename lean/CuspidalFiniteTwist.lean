import CuspidalTwistDescent
import Mathlib.FieldTheory.Fixed

/-! The finite-constant splitting field and its cyclic descent group. -/
namespace BlockingCurves.CuspidalDescent
open Function CuspidalGeneral FiniteDimensional
noncomputable section
variable {E : Type*} [Field E]

private theorem ring_pow_apply (τ : E ≃+* E) (n : ℕ) (x : E) :
    (τ^n) x = (τ : E → E)^[n] x := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [pow_succ', iterate_succ_apply']
    exact congrArg τ ih

/-- Restrict a periodic action to a stable subfield. Forward stability
already gives surjectivity since the inverse is a positive iterate. -/
private def restrictPeriodic (τ : E ≃+* E) (L : Subfield E)
    (stable : ∀ x ∈ L, τ x ∈ L) {r : ℕ} (hr : 0 < r) (period : ∀ x ∈ L, IsPeriodicPt τ r x) :
    L ≃+* L := by
  let f : L →+* L := (τ.toRingHom.comp L.subtype).codRestrict L.toSubring (fun x => stable x x.2)
  have coe : Semiconj ((↑) : L → E) f τ := fun _ => rfl
  apply RingEquiv.ofBijective f ⟨f.injective,?_⟩
  intro x
  refine ⟨(f : L → L)^[r-1] x, Subtype.ext ?_⟩
  change ↑(f ((f : L → L)^[r-1] x)) = (x : E)
  rw [← iterate_succ_apply' (f : L → L), show (r-1).succ = r by omega]
  exact (coe.iterate_right r x).trans (period x x.2)

private theorem fixed_eq_fixed_group (σ : E ≃+* E) :
    fixedField σ = FixedPoints.subfield (Subgroup.zpowers σ) E := by
  ext x
  constructor
  · intro hx g
    have h : Subgroup.zpowers σ ≤ MulAction.stabilizer (RingAut E) x :=
      Subgroup.zpowers_le.mpr hx
    exact h g.2
  · intro hx
    exact hx ⟨σ,Subgroup.mem_zpowers σ⟩

/-- The degree over the fixed subfield is the order of a finite-order
field automorphism, including when that order is divisible by the characteristic. -/
private theorem degree_fixed_of_order (σ : E ≃+* E) {r : ℕ} (hr : 0 < r)
    (h : orderOf σ = r) : finrank (fixedField σ) E = r := by
  classical
  have fin : Nat.card (Subgroup.zpowers σ) ≠ 0 := by rw [Nat.card_zpowers, h]; omega
  letI := Nat.finite_of_card_ne_zero fin
  letI := Fintype.ofFinite (Subgroup.zpowers σ)
  have eqv := FixedPoints.finrank_eq_card (Subgroup.zpowers σ) E
  have congr := congrArg (fun K : Subfield E => finrank K E) (fixed_eq_fixed_group σ)
  exact congr.trans (eqv.trans ((Nat.card_eq_fintype_card).symm.trans ((Nat.card_zpowers σ).trans h)))

variable {F : Type*} [Field F] [Fintype F] {d : ℕ} (hd : 3 ≤ d) {a : F} (ha : a ≠ 0)
  (S : Finset F) (g : GeometricSplitting d a S ≃ₐ[RatFunc (AlgebraicClosure F)] GeometricSplitting d a S)

private abbrev intercept (d : ℕ) (a : F) (S : Finset F) : GeometricSplitting d a S :=
  algebraMap (RatFunc (AlgebraicClosure F)) _ RatFunc.X

private def finiteGenerators : Set (GeometricSplitting d a S) :=
  (geomConstant d a S '' (periodicConstants F d.factorial : Set (AlgebraicClosure F))) ∪
    {intercept d a S} ∪ {x | ∃ i : S, ∃ j : Fin d, (rootLabel hd ha S i j).val = x}

/-- The actual function field generated by the q^(d!)-element constants, the
intercept, and all geometric sheets. -/
def finiteCover : Subfield (GeometricSplitting d a S) := Subfield.closure (finiteGenerators hd ha S)

private theorem constant_mem (c : AlgebraicClosure F) (hc : c ∈ periodicConstants F d.factorial) :
    geomConstant d a S c ∈ finiteCover hd ha S :=
  Subfield.subset_closure (Or.inl (Or.inl ⟨c,hc,rfl⟩))

/-- The d!-th iterate fixes the entire finite-constant cover, including its
rational functions. -/
theorem finiteCover_period (x : GeometricSplitting d a S) (hx : x ∈ finiteCover hd ha S) :
    IsPeriodicPt (twistAut d a S g) d.factorial x := by
  let τ := twistAut d a S g
  have roots : ∀ y ∈ finiteGenerators hd ha S, IsPeriodicPt τ d.factorial y := by
    rintro _ ((⟨c,hc,rfl⟩ | hparam) | ⟨i,j,rfl⟩)
    · exact (iterate_constant d a S g c _).trans (congrArg _ ((mem_periodicConstants F _ c).mp hc))
    · subst hparam
      apply Function.IsFixedPt.isPeriodicPt
      exact (twistAut_parameter d a S g RatFunc.X).trans (congrArg _ (coefficientFrobenius_X F))
    · exact frobenius_iterate_fixes_sheets hd ha S g i j
  have closureFixed : finiteCover hd ha S ≤ fixedField (τ^d.factorial) := by
    refine Subfield.closure_le.mpr fun y hy => ?_
    exact (ring_pow_apply τ _ y).trans (roots y hy)
  exact (ring_pow_apply τ _ x).symm.trans (closureFixed hx)

/-- The embedded geometric constants contained in the finite cover form
exactly the q^(d!)-element field. -/
theorem finiteCover_constant_iff (c : AlgebraicClosure F) :
    geomConstant d a S c ∈ finiteCover hd ha S ↔ c ∈ periodicConstants F d.factorial := by
  refine ⟨fun h => ?_, constant_mem hd ha S c⟩
  apply (mem_periodicConstants F _ c).mpr
  apply (geomConstant d a S).injective
  let idCover : GeometricSplitting d a S ≃ₐ[RatFunc (AlgebraicClosure F)]
      GeometricSplitting d a S := AlgEquiv.refl
  exact (iterate_constant d a S idCover c _).symm.trans (finiteCover_period hd ha S idCover _ h)

private theorem finiteCover_stable (x : GeometricSplitting d a S) (hx : x ∈ finiteCover hd ha S) :
    twistAut d a S g x ∈ finiteCover hd ha S := by
  let τ := twistAut d a S g
  have stable : finiteCover hd ha S ≤ (finiteCover hd ha S).comap τ.toRingHom := by
    apply Subfield.closure_le.mpr
    rintro _ ((⟨c,hc,rfl⟩ | hparam) | ⟨i,j,rfl⟩)
    · change twistAut d a S g _ ∈ finiteCover hd ha S
      rw [twistAut_constant]
      exact constant_mem hd ha S _ ((periodicConstants F _).pow_mem hc _)
    · subst hparam
      change twistAut d a S g (intercept d a S) ∈ finiteCover hd ha S
      rw [intercept, twistAut_parameter, coefficientFrobenius_X]
      exact Subfield.subset_closure (Or.inl (Or.inr rfl))
    · change geometricFrobenius d a S (g (rootLabel hd ha S i j).val) ∈ finiteCover hd ha S
      rw [← frobenius_coset_action]
      exact Subfield.subset_closure (Or.inr ⟨_,_,rfl⟩)
  exact stable hx

/-- The semilinear lift is an automorphism of this finite-constant field. -/
def finiteFrobenius : finiteCover hd ha S ≃+* finiteCover hd ha S :=
  restrictPeriodic (twistAut d a S g) (finiteCover hd ha S) (finiteCover_stable hd ha S g)
    (Nat.factorial_pos d) (finiteCover_period hd ha S g)

private theorem finiteFrobenius_iterate (n : ℕ) (x : finiteCover hd ha S) :
    (((finiteFrobenius hd ha S g : _ → _)^[n] x : finiteCover hd ha S) : GeometricSplitting d a S) =
      (twistAut d a S g : _ → _)^[n] x.val :=
  (show Semiconj ((↑) : finiteCover hd ha S → _) (finiteFrobenius hd ha S g) (twistAut d a S g)
    from fun _ => rfl).iterate_right n x

private theorem finite_period (x : finiteCover hd ha S) :
    IsPeriodicPt (finiteFrobenius hd ha S g) d.factorial x :=
  Subtype.ext ((finiteFrobenius_iterate hd ha S g _ x).trans (finiteCover_period hd ha S g _ x.2))

private theorem finite_marker :
    ∃ z : finiteCover hd ha S, z.val ∈ (geomConstant d a S).fieldRange ∧
      Injective (fun i : Fin d.factorial => (finiteFrobenius hd ha S g : _ → _)^[i.val] z) := by
  obtain ⟨c,hc,distinct⟩ := exists_periodic_constant F d.factorial (Nat.factorial_pos _)
  let z : finiteCover hd ha S := ⟨_, constant_mem hd ha S c ((mem_periodicConstants F _ c).mpr hc)⟩
  refine ⟨z, ⟨c,rfl⟩, ?_⟩
  intro i j eq
  apply distinct
  apply (geomConstant d a S).injective
  have trace (n : ℕ) : (((finiteFrobenius hd ha S g : _ → _)^[n] z).val) =
      geomConstant d a S (c^(Fintype.card F)^n) :=
    (finiteFrobenius_iterate hd ha S g n z).trans (iterate_constant d a S g c n)
  exact (trace i).symm.trans ((congrArg Subtype.val eq).trans (trace j))

/-- The period is exactly d!, detected on the constants, independently of
the actual permutation order on the sheets. -/
theorem finiteFrobenius_order : orderOf (finiteFrobenius hd ha S g) = d.factorial := by
  let σ := finiteFrobenius hd ha S g
  apply (orderOf_eq_iff (Nat.factorial_pos d)).mpr
  constructor
  · apply RingEquiv.ext
    intro x
    exact (ring_pow_apply σ _ x).trans (finite_period hd ha S g x)
  · intro m hm pos eq
    obtain ⟨z,_,distinct⟩ := finite_marker hd ha S g
    let i : Fin d.factorial := ⟨m,hm⟩
    let j : Fin d.factorial := ⟨0,Nat.factorial_pos _⟩
    have same : i = j := distinct ((ring_pow_apply σ m z).symm.trans (congrArg (fun e : RingAut _ => e z) eq))
    exact pos.ne' (congrArg Fin.val same)

/-- The constant descent step has the expected degree also for wild pencils. -/
theorem finite_fixed_degree : finrank (fixedField (finiteFrobenius hd ha S g)) (finiteCover hd ha S) =
    d.factorial := degree_fixed_of_order _ (Nat.factorial_pos _) (finiteFrobenius_order hd ha S g)

/-- Adjoining the constants in the finite cover to its fixed field recovers
the entire cover. One full-orbit constant already suffices. -/
theorem finite_constant_recovery :
    ∃ z : finiteCover hd ha S, z.val ∈ (geomConstant d a S).fieldRange ∧
      fixedField (finiteFrobenius hd ha S g) ⊔ Subfield.closure {z} = ⊤ := by
  obtain ⟨z,constant,distinct⟩ := finite_marker hd ha S g
  refine ⟨z,constant,eq_top_iff.mpr fun x _ => ?_⟩
  exact periodic_mem_of_marker (finiteFrobenius hd ha S g) (Nat.factorial_pos _)
    (finite_period hd ha S g z) (finite_period hd ha S g x) distinct _ le_sup_left
    (le_sup_right (b := Subfield.closure {z}) (Subfield.subset_closure rfl))

end
end BlockingCurves.CuspidalDescent
