import PencilAsymptotic
import PencilCollisionCover

/-! The horizontal term in the two-rate bound, including permutation degrees. -/
namespace BlockingCurves.PencilSampling
open Finset

variable {F : Type*} [Field F] [Fintype F]

/-- Exact number of parameters missed on one horizontal line. The cyclic
subgroup generated by g^d gives the nonzero power values, counted once each. -/
theorem horizontal_miss_exact (d : ℕ) (hd : 0 < d) (b : F) :
    (missed d (.inl b : Lines F)).card + (Fintype.card F-1) / d.gcd (Fintype.card F-1) + 1 =
      Fintype.card F := by
  classical
  obtain ⟨g,hg⟩ := IsCyclic.exists_generator (α := Fˣ)
  let G := Subgroup.zpowers (g^d)
  let v (a : G) : F := ((a.val : Fˣ) : F) - b
  have comm (j : ℤ) : (g ^ j)^d = (g^d)^j := by
    rw [← zpow_natCast, ← zpow_natCast g d, ← zpow_mul, ← zpow_mul, mul_comm]
  have vinj : Function.Injective v := by
    intro a a' h
    exact Subtype.ext (Units.ext (sub_left_inj.mp h))
  have vne : -b ∉ univ.image v := by
    rintro h
    obtain ⟨a,_,ha⟩ := mem_image.mp h
    have h0 : ((a.val : Fˣ) : F) = 0 := by dsimp [v] at ha; linear_combination ha
    exact Units.ne_zero _ h0
  have hvalues : univ.filter (Hits d (.inl b : Lines F)) = insert (-b) (univ.image v) := by
    ext y
    simp only [mem_filter,mem_univ,true_and,mem_insert,mem_image]
    constructor
    · rintro ⟨x,hx⟩
      simp only [coordinates,zero_mul,sub_zero] at hx
      by_cases hx0 : x = 0
      · left; simpa [hx0,zero_pow hd.ne'] using hx.symm
      · right
        let u := Units.mk0 x hx0
        obtain ⟨j,hj⟩ := hg u
        have hu : u^d ∈ G := ⟨j, (comm j).symm.trans (congrArg (·^d) hj)⟩
        exact ⟨⟨u^d,hu⟩,hx⟩
    · rintro (rfl | ⟨a,rfl⟩)
      · exact ⟨0, by simp [coordinates,zero_pow hd.ne']⟩
      · obtain ⟨j,hj⟩ := a.property
        refine ⟨((g^j : Fˣ) : F), ?_⟩
        simp only [coordinates,zero_mul,sub_zero]
        exact congrArg (fun u : Fˣ => (u:F)-b) ((comm j).trans hj)
  have hc := filter_card_add_filter_neg_card_eq_card (Hits d (.inl b : Lines F))
    (s := (univ : Finset F))
  rw [hvalues, card_insert_of_not_mem vne, card_image_of_injective _ vinj, card_univ,
    card_univ] at hc
  have hG : Fintype.card G = (Fintype.card F-1)/d.gcd (Fintype.card F-1) := by
    dsimp [G]; rw [Fintype.card_zpowers, orderOf_pow g, orderOf_eq_card_of_forall_mem_zpowers hg,
      Fintype.card_units, Nat.gcd_comm]
  rw [hG] at hc
  unfold missed
  omega


open Real

/-- For permutation degrees there is no horizontal restriction. Reusing
the nonhorizontal rate then makes the first entry of the maximum redundant. -/
noncomputable def horizontalRate (r : ℕ) (ν : ℝ) : ℝ :=
  if r ≤ 1 then ν else log ((r:ℝ)/(r-1))

private theorem rate_pos (r : ℕ) {ν : ℝ} (hν : 0 < ν) :
    0 < horizontalRate r ν := by
  unfold horizontalRate
  split_ifs with hr
  · exact hν
  · have h : (1:ℝ) < r := by exact_mod_cast Nat.lt_of_not_ge hr
    exact log_pos ((one_lt_div (by linarith)).mpr (by linarith))

private theorem horizontal_rate_bound (d : ℕ) (hd : 0 < d) (b : F) (ν : ℝ) :
    ((missed d (.inl b : Lines F)).card:ℝ) ≤
      Fintype.card F * exp (-horizontalRate (d.gcd (Fintype.card F-1)) ν) := by
  let q := Fintype.card F
  let r := d.gcd (q-1)
  let w := (q-1)/r
  let M := (missed d (.inl b : Lines F)).card
  have hq : 1 < q := Fintype.one_lt_card
  have hr : 0 < r := Nat.gcd_pos_of_pos_left _ hd
  have hm : M+w+1=q := horizontal_miss_exact d hd b
  have hwr : w*r+1=q := by
    have h : w*r=q-1 := Nat.div_mul_cancel (Nat.gcd_dvd_right _ _)
    omega
  change (M:ℝ) ≤ (q:ℝ)*exp (-horizontalRate r ν)
  by_cases h : r ≤ 1
  · have hr1 : r=1 := by omega
    have hM : M=0 := by rw [hr1,mul_one] at hwr; omega
    rw [hM,Nat.cast_zero]
    positivity
  · have h1 : (1:ℝ) < r := by exact_mod_cast Nat.lt_of_not_ge h
    have h0 : (0:ℝ) < r := by positivity
    have h2 : 0 < (r:ℝ)-1 := by linarith
    have h3 : (M:ℝ)+w+1=q := by exact_mod_cast hm
    have h4 : (w:ℝ)*r+1=q := by exact_mod_cast hwr
    rw [horizontalRate, if_neg h, exp_neg, exp_log (div_pos h0 h2), inv_div]
    rw [← mul_div_assoc, le_div_iff h0]
    nlinarith only [congrArg (fun a : ℝ => a*r) h3, h4,h1.le]

/-- The complete finite inputs to two-rate sampling from a *single*
nonhorizontal value-set estimate. -/
private theorem slope_bounds {d : ℕ} (hd : 0 < d) {δ C : ℝ} (hδ : 0 < δ) (hC : 0 ≤ C)
    (hline : ∀ l : Fˣ × F, ((missed d (.inr l : Lines F)).card:ℝ) ≤
      Fintype.card F * (δ+C/sqrt (Fintype.card F))) :
    ∃ H N : ℕ, (∀ b : F, (missed d (.inl b : Lines F)).card ≤ H) ∧
      (∀ l : Fˣ × F, (missed d (.inr l : Lines F)).card ≤ N) ∧
      (H:ℝ) ≤ Fintype.card F *
        exp (-horizontalRate (d.gcd (Fintype.card F-1)) (log (1/δ))) ∧
      (N:ℝ) ≤ Fintype.card F *
        exp (-(log (1/δ)-(C/δ)/sqrt (Fintype.card F))) := by
  let H := (missed d (.inl (0:F) : Lines F)).card
  let N := ⌊(Fintype.card F : ℝ)*(δ+C/sqrt (Fintype.card F))⌋₊
  refine ⟨H,N,?_,fun l => Nat.le_floor (hline l),horizontal_rate_bound d hd 0 _,?_⟩
  · intro b
    have h0 := horizontal_miss_exact d hd (0:F)
    have hb := horizontal_miss_exact d hd b
    dsimp [H]
    omega
  · exact (Nat.floor_le (by positivity)).trans (mul_le_mul_of_nonneg_left
      (additive_miss_rate (by exact_mod_cast (Fintype.card_pos : 0 < Fintype.card F)) hδ)
      (by positivity))

/-- A single nonzero-slope missing-fraction estimate δ+C/√q suffices for
the two leading coefficients, including gcd(d,q−1)=1. -/
theorem projective_upper_of_nonzero_value_set {d : ℕ} (hd : 2 ≤ d)
    {δ C : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1) (hC : 0 ≤ C)
    (hsmall : 2*(C/δ) ≤ log (1/δ)*sqrt (Fintype.card F))
    (hline : ∀ l : Fˣ × F, ((missed d (.inr l : Lines F)).card:ℝ) ≤
      Fintype.card F*(δ+C/sqrt (Fintype.card F))) :
    ∃ S : Finset F, ProjectiveBlocks d (S : Set F) ∧
      (S.card:ℝ) ≤ sampleCutoff (Fintype.card F) (1/2)
        (horizontalRate (d.gcd (Fintype.card F-1)) (log (1/δ))) (log (1/δ)) (C/δ) + 1 := by
  have hν := log_pos ((one_lt_div hδ).mpr hδ1)
  obtain ⟨H,N,hh,hn,hH,hN⟩ := slope_bounds (by omega : 0 < d) hδ hC hline
  exact projective_split_upper hd (rate_pos _ hν) hν (by positivity) hsmall hh hn hH hN

/-- The same estimate after one repair. All finite counting, concentration
of the square-root loss, and integer choices are discharged in the kernel. -/
theorem projective_loglog_of_nonzero_value_set {d : ℕ} (hd : 2 ≤ d) {c δ C : ℝ}
    (hc : 0 < c) (hz : 1/2 ≤ c*log (Fintype.card F))
    (hzq : c*log (Fintype.card F) ≤ Fintype.card F)
    (hδ : 0 < δ) (hδ1 : δ < 1) (hC : 0 ≤ C)
    (hsmall : 2*(C/δ) ≤ log (1/δ)*sqrt (Fintype.card F))
    (hline : ∀ l : Fˣ × F, ((missed d (.inr l : Lines F)).card:ℝ) ≤
      Fintype.card F*(δ+C/sqrt (Fintype.card F)))
    (hcommon : CommonHit F d ⌊c*log (Fintype.card F)⌋₊) :
    ∃ S : Finset F, ProjectiveBlocks d (S : Set F) ∧
      (S.card:ℝ) ≤ max
        ((log (Fintype.card F)-log (log (Fintype.card F))-log c+log 2)/
          horizontalRate (d.gcd (Fintype.card F-1)) (log (1/δ)))
        ((2*log (Fintype.card F)-log (log (Fintype.card F))-log c+log 2)/log (1/δ)
          + 12*(C/δ)/(log (1/δ))^2) + 2 := by
  have hν := log_pos ((one_lt_div hδ).mpr hδ1)
  obtain ⟨H,N,hh,hn,hH,hN⟩ := slope_bounds (by omega : 0 < d) hδ hC hline
  exact projective_split_loglog hd hc hz hzq (rate_pos _ hν) hν (by positivity)
    hsmall hh hn hH hN hcommon



/-- The unconditional nonzero-slope missing fraction from the collision count. -/
theorem collision_miss_fraction {d : ℕ} (hd : 2 ≤ d) (l : Fˣ × F) :
    ((missed d (.inr l : Lines F)).card:ℝ) ≤ Fintype.card F *
      (((d-1).gcd (Fintype.card F-1):ℝ)/(((d-1).gcd (Fintype.card F-1):ℝ)+1)) := by
  classical
  let f := fun x : F => x^d-(l.1:F)*x-l.2
  let I := univ.image f
  let M := missed d (.inr l : Lines F)
  let h := (d-1).gcd (Fintype.card F-1)
  have hm : M = univ \ I := by
    ext y
    simp [M,I,f,missed,Hits,coordinates]
  have hparts : M.card+I.card=Fintype.card F := by
    rw [hm,card_sdiff_add_card_eq_card (subset_univ I),card_univ]
  have him : Fintype.card F ≤ I.card*(h+1) :=
    PencilCollisionCover.nonzero_slope_image_bound d hd (l.1:F) l.2 l.1.ne_zero
  have hi : (Fintype.card F:ℝ) ≤ (I.card:ℝ)*((h:ℝ)+1) := by exact_mod_cast him
  have hc : (M.card:ℝ)+(I.card:ℝ)=Fintype.card F := by exact_mod_cast hparts
  change (M.card:ℝ) ≤ (Fintype.card F:ℝ)*((h:ℝ)/(h+1))
  rw [← mul_div_assoc,le_div_iff (by positivity)]
  linarith only [hi,hc,congrArg (fun z : ℝ => z*(h:ℝ)) hc]

/-- All characteristics and arbitrary degree. Both gcd-dependent rates use
the same sample. Neither a predetermined horizontal cover nor an external
one-line value-set theorem is required. -/
theorem projective_split_collision_upper (d : ℕ) (hd : 2 ≤ d) :
    let q := Fintype.card F
    let h : ℝ := (d-1).gcd (q-1)
    let ν := log (1+1/h)
    ∃ S : Finset F, ProjectiveBlocks d (S : Set F) ∧
      (S.card:ℝ) ≤ sampleCutoff q (1/2) (horizontalRate (d.gcd (q-1)) ν) ν 0 + 1 := by
  let h : ℝ := (d-1).gcd (Fintype.card F-1)
  have hh : 0 < h := by
    dsimp [h]
    exact_mod_cast Nat.gcd_pos_of_pos_left (Fintype.card F-1) (show 0 < d-1 by omega)
  let δ := h/(h+1)
  have hδ : 0 < δ := div_pos hh (by positivity)
  have hδ' : δ < 1 := (div_lt_one (by positivity)).2 (by linarith)
  have hν : 1/δ = 1+1/h := by dsimp [δ]; field_simp
  have hline (l : Fˣ × F) : ((missed d (.inr l : Lines F)).card:ℝ) ≤
      Fintype.card F*(δ+0/sqrt (Fintype.card F)) := by simpa [δ,h] using collision_miss_fraction hd l
  have hsmall : 2*(0/δ) ≤ log (1/δ)*sqrt (Fintype.card F) := by
    rw [zero_div,mul_zero]
    exact mul_nonneg (log_nonneg ((one_lt_div hδ).2 hδ').le) (sqrt_nonneg _)
  simpa only [zero_div,hν] using projective_upper_of_nonzero_value_set hd hδ hδ'
    (le_refl 0) hsmall hline


end BlockingCurves.PencilSampling
