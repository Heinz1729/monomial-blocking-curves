import CuspidalTwistDescent

/-! At a finite place of the descended field, the sheets are in the local
chart generated by the valuation ring and the geometric constants. -/
namespace BlockingCurves.CuspidalDescent
open Polynomial CuspidalGeneral Function
noncomputable section

private theorem integral_sheet {O M : Type*} [CommRing O] [IsDomain O] [Field M] [Algebra O M]
    {d : ℕ} (hd : 2 ≤ d) (a b : O) (x : M)
    (eqn : x^d - (algebraMap O M a*x^(d-1) + algebraMap O M b) = 0) : IsIntegral O x := by
  refine ⟨integralFibre d a b, integralFibre_monic hd _ _, ?_⟩
  simpa only [integralFibre, eval₂_sub, eval₂_add, eval₂_mul, eval₂_pow, eval₂_X, eval₂_C] using eqn

private theorem integral_iterate {O M : Type*} [CommRing O] [Field M] [Algebra O M]
    (τ : M ≃+* M) (comm : ∀ a : O, τ (algebraMap O M a) = algebraMap O M a)
    {x : M} (hx : IsIntegral O x) (n : ℕ) : IsIntegral O ((τ : M → M)^[n] x) := by
  let f : M →ₐ[O] M := { τ.toRingHom with commutes' := comm }
  induction n with
  | zero => exact hx
  | succ n ih =>
    rw [iterate_succ_apply']
    exact IsIntegral.map (R:=O) (A:=O) f ih

private theorem valuation_mem_of_integral {K : Type*} [Field K] (O : ValuationSubring K)
    {x : K} (h : IsIntegral O x) : x ∈ O := by
  obtain ⟨P,monic,root⟩ := h
  exact monic_root_mem_valuation O monic root

variable {F : Type*} [Field F] [Fintype F] {d : ℕ} (hd : 3 ≤ d) {a : F} (ha : a ≠ 0)
  (S : Finset F) (g : GeometricSplitting d a S ≃ₐ[RatFunc (AlgebraicClosure F)] GeometricSplitting d a S)

/-- Interpolate a sheet on its Frobenius orbit using a constant of period d!.
The coefficients are simultaneously invariant and integral, hence belong to
the original valuation ring. No unramifiedness assumption is needed here. -/
theorem sheets_mem_local_chart (O : ValuationSubring (twistField d a S g)) (embed : F →+* O)
    (base : ∀ c, (((embed c : O) : twistField d a S g) : GeometricSplitting d a S) =
      geomConstant d a S (algebraMap F (AlgebraicClosure F) c))
    (t : O) (param : ((t : twistField d a S g) : GeometricSplitting d a S) =
      algebraMap (RatFunc (AlgebraicClosure F)) _ RatFunc.X)
    (B : Subring (GeometricSplitting d a S)) (constants : ∀ c, geomConstant d a S c ∈ B)
    (old : ∀ y : O, ((y : twistField d a S g) : GeometricSplitting d a S) ∈ B)
    (α : S) (j : Fin d) : (rootLabel hd ha S α j).val ∈ B := by
  classical
  let M := GeometricSplitting d a S
  let D := twistField d a S g
  let τ := twistAut d a S g
  let ι := geomConstant d a S
  let μ : O →+* M := D.subtype.comp O.subtype
  letI : Algebra O M := μ.toAlgebra
  let A : Subring M := (integralClosure O M).toSubring
  let x := (rootLabel hd ha S α j).val
  have scalar : (algebraMap O M).comp embed = ι.comp (algebraMap F (AlgebraicClosure F)) :=
    RingHom.ext base
  have constantInt : ι.fieldRange.toSubring ≤ A := by
    rintro _ ⟨c,rfl⟩
    exact IsIntegral.map_of_comp_eq embed ι scalar (Algebra.IsIntegral.isIntegral (R:=F) c)
  have rootInt : IsIntegral O x := by
    apply integral_sheet (by omega : 2≤d) (embed a) (t+embed α.val)
    have eqn := (mem_rootSet.mp (rootLabel hd ha S α j).property).2
    simp only [cuspCoordinate,lineFibre,map_sub,map_add,map_mul,map_pow,aeval_X,aeval_C] at eqn
    rw [map_add]
    change x^d - (μ (embed a) * x^(d-1) + (μ t + μ (embed α.val))) = 0
    rw [show μ (embed a) = _ from base a, show μ t = _ from param,
      show μ (embed α.val) = _ from base α.val]
    exact eqn
  have ints (n : ℕ) : IsIntegral O ((τ : M → M)^[n] x) :=
    integral_iterate τ (fun y : O => y.val.property) rootInt n
  obtain ⟨θ,hθ,distinct⟩ := exists_periodic_constant F d.factorial (Nat.factorial_pos _)
  let z := ι θ
  have hz : IsPeriodicPt τ d.factorial z := (iterate_constant d a S g θ _).trans (congrArg ι hθ)
  have hx : IsPeriodicPt τ d.factorial x := frobenius_iterate_fixes_sheets hd ha S g α j
  have inj : Injective (fun i : Fin d.factorial => (τ : M → M)^[i.val] z) := by
    intro i j eq
    apply distinct
    apply ι.injective
    exact (iterate_constant d a S g θ i).symm.trans (eq.trans (iterate_constant d a S g θ j))
  let P := orbitPolynomial τ d.factorial z x
  obtain ⟨hP,eval⟩ := orbitPolynomial_fixed_eval τ (Nat.factorial_pos _) hz hx inj
  change P.map τ.toRingHom = P at hP
  change P.eval z = x at eval
  let inc : D →ₐ[O] M := { D.subtype with commutes' := fun _ => rfl }
  have coeff (n : ℕ) : P.coeff n ∈ B := by
    have integral : IsIntegral O (P.coeff n) := orbitPolynomial_coeff_mem τ _ z x ι.fieldRange A
      constantInt (fun i => ⟨_,(iterate_constant d a S g θ i).symm⟩) (fun i => ints i) n
    have fixed : τ (P.coeff n) = P.coeff n :=
      (coeff_map τ.toRingHom n).symm.trans (congrArg (fun Q : M[X] => Q.coeff n) hP)
    let y : D := ⟨P.coeff n,fixed⟩
    have iy : IsIntegral O y := (isIntegral_algHom_iff inc inc.injective).mp integral
    exact old ⟨y,valuation_mem_of_integral O iy⟩
  change x ∈ B
  rw [←eval,Polynomial.eval,eval₂_eq_sum,sum_def]
  exact B.sum_mem fun n _ => B.mul_mem (coeff n) (B.pow_mem (constants θ) n)

end
end BlockingCurves.CuspidalDescent
