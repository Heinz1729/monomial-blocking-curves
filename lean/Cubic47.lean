import CubicCertificate

/-! Exhaustive certificate for the vertical translates of y=x³ over F₄₇.
A natural number encodes a subset of the 47 residues by its membership bits.
Every decimal row below is compared with the original cubic expression in
`rows_verified`. No native reduction or assumed row table is used. -/
namespace CubicPencil47

set_option maxRecDepth 4096
set_option maxHeartbeats 0

def residues := List.range 47

/-- Bit j is present precisely when one of the inputs is j. -/
def maskOf (xs : List Nat) : Nat := xs.foldr (fun x acc => (1 <<< x) ||| acc) 0

/-- Values x³+mx+b mod 47 on the 47 residues. -/
def cubicValues (m b : Nat) : List Nat :=
  residues.map fun x => (x*x*x + m*x + b) % 47

def allRows : List Nat :=
  residues.bind fun m => residues.map fun b => maskOf (cubicValues m b)

/-- A normalized set already contains 0 and 1. Only these rows can miss it. -/
def difficultRows : List Nat := allRows.filter fun r => (r &&& 3) == 0

