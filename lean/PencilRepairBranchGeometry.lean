import PencilRepairBranchField
import CubicGenusTransport
import CubicPoleDegree

/-! Rational places and Castelnuovo–Severi on the field generated by the actual
Laurent roots. Residue interpolation proves the pole-fibre bound. The two
classical inputs are Castelnuovo–Severi and Hasse–Weil on that field. -/
namespace BlockingCurves.PencilRepairBranch
open Polynomial IntermediateField FiniteDimensional PencilSampling Finset
noncomputable section
universe u
variable {F : Type u} [Field F] {d : ℕ} {R : Finset (Lines F)}

def parameter (D : Model F d R) := algebraMap (RatFunc F) D.K RatFunc.X
abbrev constant (D : Model F d R) := CubicRepairPlaces.baseConstant F D.K

/-- A rational place, with its valuation ring and its base-field residue map. -/
abbrev Place (D : Model F d R) := CubicRepairPlaces.RationalPlace F D.K

private theorem regular_root {K : Type*} [Field K] (O : ValuationSubring K) (hd : 2 ≤ d)
    {x m c : K} (hm : m ∈ O) (hc : c ∈ O) (he : x^d = m*x+c) : x ∈ O := by
  by_contra hn
  obtain ⟨k,rfl⟩ : ∃ k, d = k+2 := ⟨d-2,by omega⟩
  have hx : x ≠ 0 := fun h => hn (h ▸ O.zero_mem)
  have hi := (O.mem_or_inv_mem x).resolve_left hn
  have h₁ : x*(x⁻¹)^(k+1) = (x⁻¹)^k := by
    rw [pow_succ, mul_comm ((x⁻¹)^k), ← mul_assoc, mul_inv_cancel hx, one_mul]
  have h₂ : x^(k+2)*(x⁻¹)^(k+1) = x := by
    rw [pow_succ,mul_comm (x^(k+1)) x, mul_assoc, ← mul_pow, mul_inv_cancel hx, one_pow, mul_one]
  apply hn
  rw [← h₂, he, add_mul, mul_assoc, h₁]
  exact add_mem (mul_mem hm (pow_mem hi _)) (mul_mem hc (pow_mem hi _))

/-- Every nonpolar rational place of the constructed field yields a common hit. -/
theorem hit_of_regular_place (hd : 2 ≤ d) (D : Model F d R) (v : Place D)
    (hv : parameter D ∈ v.ring) : ∃ a : F, ∀ l ∈ R, Hits d l a := by
  let t : v.ring := ⟨parameter D,hv⟩
  let c (a : F) : v.ring := ⟨constant D a,v.constants a⟩
  refine ⟨v.residue t,?_⟩
  intro l hl
  let i : R := ⟨l,hl⟩
  have he : (D.root i)^d = constant D (coordinates l).1*D.root i + (parameter D+constant D (coordinates l).2) := by
    simpa [constant,parameter,i] using D.equation i
  have hr := regular_root v.ring hd (v.constants _) (add_mem hv (v.constants _)) he
  let x : v.ring := ⟨D.root i,hr⟩
  have ee : x^d = c (coordinates l).1*x+(t+c (coordinates l).2) := by
    apply Subtype.ext
    change v.ring.toSubring.subtype (x^d) = v.ring.toSubring.subtype (c (coordinates l).1*x+(t+c (coordinates l).2))
    simpa only [map_pow,map_mul,map_add] using he
  have h := congrArg v.residue ee
  simp only [map_pow,map_add,map_mul,c,v.on_constants] at h
  exact ⟨v.residue x,by linear_combination h⟩

def stage (D : Model F d R) (S : Finset R) := adjoin (RatFunc F) (D.root '' (S : Set R))

/-- The two subfields generate the indicated stage, and adjoining its
remaining roots computes the extension over the first subfield. -/
theorem stage_adjoin_union [DecidableEq R] (D : Model F d R) (S T : Finset R) :
    (adjoin (stage D S) (D.root '' (T : Set R))).restrictScalars (RatFunc F) = stage D (S ∪ T) := by
  simp only [stage, coe_union, Set.image_union, adjoin_adjoin_left]

theorem stage_sup [DecidableEq R] (D : Model F d R) (S T : Finset R) :
    stage D S ⊔ stage D T = stage D (S ∪ T) := by
  simp only [stage, coe_union, Set.image_union]
  exact IntermediateField.gc.l_sup.symm

def relativeDegree (D : Model F d R) (S T : Finset R) :=
  finrank (stage D S) (adjoin (stage D S) (D.root '' (T : Set R)))

theorem relative_degree_le (hd : 2 ≤ d) (D : Model F d R) (S T : Finset R) :
    relativeDegree D S T ≤ d^T.card := by
  let B := RatFunc F
  let E := stage D S
  exact (generated_degree hd T D.root
    (fun i => algebraMap B E (RatFunc.C (coordinates i.val).1))
    (fun i => algebraMap B E (RatFunc.X + RatFunc.C (coordinates i.val).2))
    (fun i _ => by simpa only [← IsScalarTower.algebraMap_apply B E D.K] using D.equation i)).2

private instance coefficientAlgebra {K : Type u} [Field K] [Algebra (RatFunc F) K]
    (E : IntermediateField (RatFunc F) K) : Algebra F E :=
  ((algebraMap (RatFunc F) E).comp RatFunc.C).toAlgebra

abbrev stageForms (D : Model F d R) (S : Finset R) := CubicRationalGenus.regularForms F (stage D S)
abbrev stageGenus (D : Model F d R) (S : Finset R) := CubicRationalGenus.genus F (stage D S)

private theorem base_rational (D : Model F d R) : Nonempty (RatFunc F ≃ₐ[F] stage D ∅) := by
  let T (E : IntermediateField (RatFunc F) D.K) := Nonempty (RatFunc F ≃ₐ[F] E)
  change T _
  rw [show stage D ∅ = ⊥ by simp [stage]]
  exact ⟨AlgEquiv.ofRingEquiv (f := (IntermediateField.botEquiv (RatFunc F) D.K).symm.toRingEquiv)
    (by intro a; rfl)⟩

theorem single_rational (D : Model F d R) (i : R) : Nonempty (RatFunc F ≃ₐ[F] stage D {i}) := by
  obtain ⟨e,he⟩ := CubicRepairPlaces.rational_single_of_equation (D.root i) d _ _ (D.equation i)
  let T (E : IntermediateField (RatFunc F) D.K) := Nonempty (RatFunc F ≃ₐ[F] E)
  change T _
  rw [show stage D {i} = adjoin (RatFunc F) {D.root i} by simp [stage]]
  exact ⟨AlgEquiv.ofRingEquiv (f := e) (fun a => Subtype.ext (he a))⟩

/-- Castelnuovo–Severi, in the cardinal rank of regular differentials on the
two stages, with relative degrees in their compositum. -/
def CompositumBound (D : Model F d R) : Prop := by
  classical
  exact ∀ (S : Finset R) (i : R), i ∉ S → FiniteDimensional F (stageForms D S) →
    Module.rank F (stageForms D (insert i S)) ≤
      ((relativeDegree D S {i} * stageGenus D S + relativeDegree D {i} S * stageGenus D {i} +
        (relativeDegree D S {i}-1)*(relativeDegree D {i} S-1) : ℕ) : Cardinal)

/-- Both finite dimensionality and the bound g ≤ |S| d^|S| follow from the
classical compositum inequality. The base and single-root stages are rational. -/
theorem stage_genus_bound (hd : 2 ≤ d) (D : Model F d R) (cs : CompositumBound D) (S : Finset R) :
    FiniteDimensional F (stageForms D S) ∧ stageGenus D S ≤ S.card*d^S.card := by
  classical
  induction S using Finset.induction_on with
  | empty =>
    exact ⟨CubicRationalGenus.rational_finiteDimensional (base_rational D).some,
      by rw [show stageGenus D ∅ = 0 from CubicRationalGenus.rational_genus_zero (base_rational D).some]; simp⟩
  | @insert i S hi ih =>
    have h := cs S i hi ih.1
    let b := Basis.ofVectorSpace F (stageForms D (insert i S))
    letI := b.fintypeIndexOfRankLtAleph0 (h.trans_lt (Cardinal.nat_lt_aleph0 _))
    letI := FiniteDimensional.of_fintype_basis b
    have hsingle : stageGenus D {i} = 0 := CubicRationalGenus.rational_genus_zero (single_rational D i).some
    rw [← FiniteDimensional.finrank_eq_rank', hsingle, Nat.mul_zero, Nat.add_zero] at h
    have h₁ : relativeDegree D S {i} ≤ d := by simpa using relative_degree_le hd D S {i}
    have h₂ := relative_degree_le hd D {i} S
    have hcross := Nat.mul_le_mul ((Nat.sub_le _ 1).trans h₁) ((Nat.sub_le _ 1).trans h₂)
    refine ⟨inferInstance,(Nat.cast_le.mp h).trans ?_⟩
    rw [card_insert_of_not_mem hi,pow_succ]
    calc
      _ ≤ d*(S.card*d^S.card) + d*d^S.card := Nat.add_le_add (Nat.mul_le_mul h₁ ih.2) hcross
      _ = _ := by ring

def genus (D : Model F d R) : ℕ := by
  letI : Algebra F D.K := (constant D).toAlgebra
  exact CubicRationalGenus.genus F D.K

theorem full_stage_genus (D : Model F d R) : stageGenus D univ = genus D := by
  letI : Algebra F D.K := (constant D).toAlgebra
  let E := stage D univ
  have he : E = ⊤ := by simpa only [E,stage,coe_univ,Set.image_univ] using D.generated
  let e : E ≃ₐ[RatFunc F] D.K := (equivOfEq he).trans IntermediateField.topEquiv
  apply CubicRationalGenus.genus_congr (F := F)
  exact AlgEquiv.ofRingEquiv (f := e.toRingEquiv) (fun a => e.commutes (RatFunc.C a))

variable [Fintype F]

/-- Fundamental inequality for the single fibre over the pole of t. -/
def PoleFibreBound (D : Model F d R) : Prop :=
  ∀ P : Finset (Place D), (∀ v ∈ P, parameter D ∉ v.ring) → P.card ≤ finrank (RatFunc F) D.K

/-- Residue interpolation over the rational parameter bounds the full polar
fibre of every Laurent model, in arbitrary characteristic. -/
theorem pole_fibre_bound (hd : 2 ≤ d) (D : Model F d R) : PoleFibreBound D := by
  letI := (model_degree hd D).1
  exact CubicPoleDegree.field_pole_degree D.K

/-- The lower Hasse–Weil inequality on degree-one places of the actual branch. -/
def HasseWeilBound (D : Model F d R) : Prop :=
  (Fintype.card F : ℝ)+1 - 2*(genus D:ℝ)*Real.sqrt (Fintype.card F) ≤ (Nat.card (Place D) : ℝ)

/-- The three classical inputs imply a geometrically usable finite threshold.
Both the genus recurrence and reduction at a nonpolar place are internal. -/
theorem common_of_curve_bounds (hd : 2 ≤ d) (D : Model F d R) (cs : CompositumBound D)
    (hw : HasseWeilBound D) (poles : PoleFibreBound D)
    (hsize : (d:ℝ)^R.card + 2*R.card*(d:ℝ)^R.card*Real.sqrt (Fintype.card F) <
      (Fintype.card F:ℝ)+1) :
    ∃ a : F, ∀ l ∈ R, Hits d l a := by
  classical
  have hg := (stage_genus_bound hd D cs univ).2
  rw [full_stage_genus,card_univ,Fintype.card_coe] at hg
  have hr : (genus D:ℝ) ≤ R.card*(d:ℝ)^R.card := by exact_mod_cast hg
  have herr := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hr (by norm_num : (0:ℝ)≤2))
    (Real.sqrt_nonneg (Fintype.card F))
  unfold HasseWeilBound at hw
  have hlt : (d:ℝ)^R.card < (Nat.card (Place D):ℝ) := by
    linarith only [hsize,hw,herr]
  have hn : d^R.card < Nat.card (Place D) := by exact_mod_cast hlt
  letI : Finite (Place D) := (Nat.card_pos_iff.mp ((Nat.zero_le _).trans_lt hn)).2
  letI : Fintype (Place D) := Fintype.ofFinite _
  by_contra hnone
  have hp (v : Place D) : parameter D ∉ v.ring := fun h => hnone (hit_of_regular_place hd D v h)
  have hc := (poles univ (fun v _ => hp v)).trans (model_degree hd D).2
  rw [card_univ,← Nat.card_eq_fintype_card] at hc
  exact (Nat.not_le_of_lt hn) hc

/-- Common-hit input to the one-parameter repair from three independent classical
inequalities on the constructed branch fields. The statement includes horizontal lines. -/
theorem commonHit_of_curve_bounds {t : ℕ} (hd : 2 ≤ d) (hp : (d:F) ≠ 0)
    (cs : ∀ (R : Finset (Lines F)), R.card ≤ t → ∀ D : Model F d R, CompositumBound D)
    (hw : ∀ (R : Finset (Lines F)), R.card ≤ t → ∀ D : Model F d R, HasseWeilBound D)
    (poles : ∀ (R : Finset (Lines F)), R.card ≤ t → ∀ D : Model F d R, PoleFibreBound D)
    (hsize : (d:ℝ)^t + 2*t*(d:ℝ)^t*Real.sqrt (Fintype.card F) < (Fintype.card F:ℝ)+1) :
    CommonHit F d t := by
  intro R hR
  obtain ⟨D⟩ := model_exists hd hp R
  apply common_of_curve_bounds hd D (cs R hR D) (hw R hR D) (poles R hR D)
  apply lt_of_le_of_lt _ hsize
  have hd₁ : (1:ℝ) ≤ d := by exact_mod_cast (by omega : 1 ≤ d)
  have hpow : (d:ℝ)^R.card ≤ (d:ℝ)^t := pow_le_pow_right hd₁ hR
  have hcard : (R.card:ℝ) ≤ t := by exact_mod_cast hR
  gcongr

/-- With the polar fibre proved, only Castelnuovo–Severi and Hasse–Weil
remain as geometric inputs to the repair theorem. -/
theorem commonHit_of_classical_bounds {t : ℕ} (hd : 2 ≤ d) (hp : (d:F) ≠ 0)
    (cs : ∀ (R : Finset (Lines F)), R.card ≤ t → ∀ D : Model F d R, CompositumBound D)
    (hw : ∀ (R : Finset (Lines F)), R.card ≤ t → ∀ D : Model F d R, HasseWeilBound D)
    (hsize : (d:ℝ)^t + 2*t*(d:ℝ)^t*Real.sqrt (Fintype.card F) < (Fintype.card F:ℝ)+1) :
    CommonHit F d t :=
  commonHit_of_curve_bounds hd hp cs hw (fun _ _ D => pole_fibre_bound hd D) hsize

end
end BlockingCurves.PencilRepairBranch
